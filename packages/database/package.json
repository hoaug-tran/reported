{
  "name": "@reported/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/seed.ts",
    "db:clean": "tsx src/clean.ts"
  },
  "dependencies": {
    "@reported/contracts": "workspace:*",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
